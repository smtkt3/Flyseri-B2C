# Server root .env only. Never VITE_* or browser settings.
# Use your mailbox provider's approved SMTP values and app password.
# Leave disabled until the sender and credentials are configured.
TICKET_EMAIL_ENABLED=false
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tickets@your-verified-domain.com
SMTP_PASSWORD=replace-with-mailbox-app-password
SMTP_FROM_EMAIL=tickets@your-verified-domain.com
# Port 587: set SMTP_SECURE=false; STARTTLS remains required.
