# Backend runtime. Copy to .env and set values for your environment.
APP_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:8443

# Supabase project jkgkpgdwzuxletrmseqv (set the password in your private .env).
# Download its SSL certificate from Database Settings to certs/supabase-root-2021.crt.
# Append ?sslmode=verify-full&sslrootcert= followed by the URL-encoded ABSOLUTE certificate path.
# Restricted API login through the session pooler (see supabase/flyseri-api-role.sql):
# DATABASE_URL=postgresql://flyseri_api.jkgkpgdwzuxletrmseqv:[ROLE-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=[ENCODED-ABSOLUTE-CERT-PATH]
# Administrator connection, used only for migrations and provisioning:
# DATABASE_URL=postgresql://postgres.jkgkpgdwzuxletrmseqv:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=[ENCODED-ABSOLUTE-CERT-PATH]
# Direct administrator connection where network access permits:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jkgkpgdwzuxletrmseqv.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=[ENCODED-ABSOLUTE-CERT-PATH]
# Local PostgreSQL alternative:
# DATABASE_URL=postgresql://flyseri:flyseri@localhost:5432/flyseri
# REDIS_URL=redis://localhost:6379

# Customer authentication. URL and anon key are public.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Phase 4 private document storage. Keep the secret key on the API server only.
# Create a PRIVATE travel-documents bucket before enabling uploads.
# SUPABASE_STORAGE_SECRET_KEY=your-server-only-secret-key
DOCUMENT_BUCKET=travel-documents
DOCUMENT_MAX_UPLOAD_MB=10
DOCUMENT_SIGNED_URL_TTL_SECONDS=60

# Sabre CERT REST OAuth v3, BFM v5 and Revalidate Itinerary v5. Server-side only.
# Configure in the server's secret environment; no credential belongs in VITE_*.
SABRE_ENV=CERT
# SABRE_BASE_URL=https://api.cert.platform.sabre.com
# SABRE_AUTH_URL=https://api.cert.platform.sabre.com/v3/auth/token
# SABRE_CLIENT_ID=your-client-id
# SABRE_CLIENT_SECRET=your-client-secret
# SABRE_USERNAME=your-EPR-your-PCC-AA
# SABRE_PASSWORD=your-password
# SABRE_PCC=your-pcc
SABRE_TOKEN_EXPIRY_SKEW_SECONDS=60
SABRE_BFM_CACHE_TTL_SECONDS=300
SABRE_SEARCH_SESSION_TTL_SECONDS=900
SABRE_REQUEST_TIMEOUT_MS=12000
SABRE_SEARCH_RATE_LIMIT_PER_MINUTE=12
SABRE_PROVIDER_RATE_LIMIT_PER_MINUTE=120
SABRE_PROVIDER_MAX_CONCURRENT=12
SABRE_SHOPPING_POLICY_VERSION=1
FLIGHT_BOOKING_INTENT_RATE_LIMIT_PER_MINUTE=20
FLIGHT_VALIDATION_RATE_LIMIT_PER_MINUTE=6
# Internal freshness policy, not an airline fare guarantee.
FLIGHT_VALIDATION_TTL_SECONDS=180
# Reservation creation is CERT-only and needs approved agency details.
FLIGHT_BOOKING_EXECUTION_ENABLED=false
# CERT issuance requires approved non-cash settlement, printers and evidence migration.
FLIGHT_TICKETING_EXECUTION_ENABLED=false
# Ancillary additions require the approved ticketing profile and evidence migration too.
FLIGHT_ANCILLARY_EXECUTION_ENABLED=false
# Optional server-only approved merchant FX rates; public display rates cannot be charged.
# FLIGHT_EXTRA_CHECKOUT_FX_RATES is keyed by SOURCE:CHECKOUT with numerator, denominator and validUntil.
# SABRE_TICKETING_PROFILE is server-only JSON. See reference/sabre/CERT_TICKETING_ACTIVATION.md.
# SABRE_BOOKING_AGENCY={"address":{"name":"","street":"","city":"","stateProvince":"","postalCode":"","countryCode":"","freeText":""},"agencyCustomerNumber":"","ticketingPolicy":""}

# Stripe test checkout starts only after a persisted Sabre PNR and signed webhook setup.
PAYMENT_PROVIDER=NONE
PAYMENT_CHECKOUT_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_... (API server only)
# STRIPE_WEBHOOK_SECRET=whsec_... (API server only)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_... (public browser key; hosted Checkout does not use it)

# Seri AI is disabled until a server-side provider key and privacy review are configured.
SERI_AI_ENABLED=false
# Server-only Sabre CERT MCP hotel discovery; hotel purchases remain unavailable.
SERI_SABRE_MCP_ENABLED=false
SERI_AI_STREAMING_ENABLED=false
SERI_AI_WRITE_TOOLS_ENABLED=false
SERI_AI_FALLBACK_ENABLED=false
AI_PRIMARY_PROVIDER=GEMINI
AI_PRIMARY_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=server-only-key
# AI_FALLBACK_PROVIDER=GEMINI
# AI_FALLBACK_MODEL=gemini-2.5-pro
AI_PROVIDER_TIMEOUT_MS=20000
AI_RATE_LIMIT_MESSAGES_PER_MINUTE=12
AI_RATE_LIMIT_TOOL_CALLS_PER_MINUTE=24
AI_MAX_TOOL_CALLS_PER_TURN=4
AI_MAX_OUTPUT_TOKENS=900
AI_MAX_CONTEXT_MESSAGES=16

# Shared only between the CRM server and Flyseri API. Never expose to browser code.
# B2C_ADMIN_SHARED_SECRET=replace-with-a-random-secret-at-least-32-characters
# CRM delivery is a separate server process: pnpm --filter @flyseri/api crm:sync-worker.
# Configure both fields together and share the secret only with the CRM server.
# CRM_SYNC_URL=http://localhost:3095/api/internal/flyseri-events
# CRM_SYNC_SHARED_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

# Optional public browser setting, read by Vite. Never put secrets in VITE_*.
# VITE_API_BASE_URL=/api/v1

# Server-only AES-256 key for saved traveler passports (64 hexadecimal characters).
# Keep this key stable and backed up; changing it prevents reading existing saved passports.
# Private Supabase bucket: traveller-private-data (scripts/setup-traveller-vault.mjs).
# TRAVELLER_DATA_ENCRYPTION_KEY=generate-with-node-crypto-randomBytes-32

# Opt-in CERT-only warming. Only recently repeated, exact searches are refreshed.
# One warm search performs the existing two supplier shop calls; normal quotas still apply.
SABRE_CACHE_WARMUP_ENABLED=false
SABRE_CACHE_WARMUP_SEARCHES_PER_MINUTE=1
SABRE_CACHE_WARMUP_MAX_ROUTES=3
# Detailed per-fare logs are opt-in; timings and offer counts are always logged.
SABRE_VERBOSE_SEARCH_LOGGING=false

