# Merge only the approved server settings into the workspace root .env.
# This file is a template, not a second environment loaded by the API.
# Keep all existing Sabre CERT authentication and Stripe test settings.
SABRE_ENV=CERT

# Use only the verified printer. The user authorized CASH for CERT staff tests;
# client payments still use Stripe sandbox and must be verified first.
# SABRE_TICKETING_PROFILE={"hardcopyPrinterAddress":"<verified 6-character address>","formOfPayment":"CASH","ticketCountryCode":"BD"}
# Non-cash alternatives require their actual configured agency/card details:
# SABRE_TICKETING_PROFILE={"hardcopyPrinterAddress":"<approved 6-character address>","formOfPayment":"INVOICE","invoiceDescription":"<approved agency invoice description>"}
# ticketCountryCode is optional: Sabre documents it as the ticket STOCK country
# code, used only when explicitly designating that ticket-printer stock.
# The current Bangladesh CERT trial needs explicit BD ticket stock: hardcopy-only
# returned PRINTER_NOT_ASSIGNED. This does not resolve the separate host error
# TICKETING IN ALTERNATE CURRENCY NOT ALLOWED-2101; Sabre must review that restriction.

# Template defaults remain disabled; enable explicitly for the verified profile.
FLIGHT_TICKETING_EXECUTION_ENABLED=false

# Keep these false for the manager-approved admin servicing workflow.
FLIGHT_AUTOMATIC_TICKETING_ENABLED=false
FLIGHT_CUSTOMER_TICKETING_ENABLED=false

# Separate opt-ins after the connected contracts and PCC permissions are reviewed.
# Existing-ticket cancellation requires a verified hardcopy printer, not a new
# ticket payment profile. Keep this value server-only.
# SABRE_SERVICING_PRINTER=<verified 6-character hardcopy PTR>
FLIGHT_TICKET_SERVICING_EXECUTION_ENABLED=false
FLIGHT_REFUND_SETTLEMENT_ENABLED=false
# Exchanges with additional collection require a verified servicing payment flow.
