{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "nestjs",
      "buildCommand": "pnpm --dir ../.. --filter ./packages/** -r build && pnpm --dir ../.. --filter @flyseri/api build"
    },
    "customer-web": {
      "root": "apps/customer-web",
      "framework": "vite",
      "buildCommand": "pnpm --dir ../.. --filter ./packages/** -r build && pnpm --dir ../.. --filter @flyseri/customer-web build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "customer-web"
      }
    }
  ]
}
