        "body": {
          "mode": "raw",
          "raw": "{\n    \"bookingSignature\": \"{{bookingSignature}}\",\n    \"confirmationId\": \"{{pnr}}\",\n    \"before\": {\n        \"travelers\": [\n            {\n                \"givenName\": \"JOHN\",\n                \"surname\": \"SMITH\",\n                \"type\": \"ADULT\",\n                \"passengerCode\": \"ADT\",\n                \"nameAssociationId\": \"1\"\n            },\n            {\n                \"givenName\": \"MARRY\",\n                \"surname\": \"SMITH\",\n                \"type\": \"ADULT\",\n                \"passengerCode\": \"ADT\",\n                \"nameAssociationId\": \"2\"\n            }\n        ]\n    },\n    \"after\": {\n        \"travelers\": [\n            {\n                \"givenName\": \"JOHN\",\n                \"surname\": \"SMITH\",\n                \"type\": \"ADULT\",\n                \"passengerCode\": \"ADT\",\n                \"nameAssociationId\": \"1\",\n                \"ancillaries\": [\n                    {\n                        \"flights\": [\n                            {\n                                \"itemId\": {{atpco_flight1_itemId}}\n                            }\n                        ],\n                        \"reasonForIssuanceName\": \"{{flight_1_ancillary_1_reasonForIssuance}}\",\n                        \"subcode\": \"{{flight_1_ancillary_1_subCode}}\",\n                        \"airlineCode\": \"{{flight_1_ancillary_1_airline}}\",\n                        \"electronicMiscellaneousDocumentType\": \"{{flight_1_ancillary_1_electronicMiscDocType}}\",\n                        \"basePrice\": \"{{flight_1_ancillary_1_basePrice}}\",\n                        \"currencyCode\": \"{{flight_1_ancillary_1_currencyCode}}\",\n                        \"groupCode\": \"{{flight_1_ancillary_1_group}}\",\n                        \"totals\": {\n                            \"subtotal\": \"{{flight_1_ancillary_1_subtotal}}\",\n                            \"taxes\": \"{{flight_1_ancillary_1_taxes}}\",\n                            \"total\": \"{{flight_1_ancillary_1_total}}\",\n                            \"currencyCode\": \"{{flight_1_ancillary_1_currencyCode}}\"\n                        }\n                    }\n                ]\n            },\n            {\n                \"givenName\": \"MARRY\",\n                \"surname\": \"SMITH\",\n                \"type\": \"ADULT\",\n                \"passengerCode\": \"ADT\",\n                \"nameAssociationId\": \"1\",\n                \"ancillaries\": [\n                    {\n                        \"flights\": [\n                            {\n                                \"itemId\": {{atpco_flight1_itemId}}\n                            }\n                        ],\n                        \"reasonForIssuanceName\": \"{{flight_1_ancillary_1_reasonForIssuance}}\",\n                        \"subcode\": \"{{flight_1_ancillary_1_subCode}}\",\n                        \"airlineCode\": \"{{flight_1_ancillary_1_airline}}\",\n                        \"electronicMiscellaneousDocumentType\": \"{{flight_1_ancillary_1_electronicMiscDocType}}\",\n                        \"basePrice\": \"{{flight_1_ancillary_1_basePrice}}\",\n                        \"currencyCode\": \"{{flight_1_ancillary_1_currencyCode}}\",\n                        \"groupCode\": \"{{flight_1_ancillary_1_group}}\",\n                        \"totals\": {\n                            \"subtotal\": \"{{flight_1_ancillary_1_subtotal}}\",\n                            \"taxes\": \"{{flight_1_ancillary_1_taxes}}\",\n                            \"total\": \"{{flight_1_ancillary_1_total}}\",\n                            \"currencyCode\": \"{{flight_1_ancillary_1_currencyCode}}\"\n                        }\n                    }\n                ]\n            }\n        ]\n    },\n    \"retrieveBooking\": true,\n    \"receivedFrom\": \"Booking Management API testing\"\n}"
